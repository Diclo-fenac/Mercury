# Core App
PORT=8000
MERCURY_MODE=full
SECRET_KEY=<random-32-byte-string>
MERCURY_ADMIN_KEY=sk_live_default_admin_key_123  # Master API Key for the Dashboard

# Typesense
TYPESENSE_HOST=typesense
TYPESENSE_PORT=8108
TYPESENSE_API_KEY=<admin-key>
TYPESENSE_SEARCH_API_KEY=<public-key>

# Google Gemini
GEMINI_API_KEY=<your-gemini-key>
GEMINI_MODEL_NAME=gemini-1.5-pro

# Postgres
DATABASE_URL=postgresql://mercury:mercury@postgres:5432/mercury
# Or: POSTGRES_USER, POSTGRES_PASSWORD, POSTGRES_HOST, POSTGRES_PORT, POSTGRES_DB

# Redis
REDIS_URL=redis://redis:6379/0
# Or: REDIS_HOST, REDIS_PORT, REDIS_PASSWORD

# CORS / WebSocket
ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
WS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# Optional S3
AWS_ACCESS_KEY_ID=<key>
AWS_SECRET_ACCESS_KEY=<secret>
S3_BUCKET_NAME=<bucket>
S3_REGION=<region>

# Optional Embedding
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
MODEL_CACHE_DIR=/app/models

# Telemetry / Prometheus
PROMETHEUS_ENABLED=true
