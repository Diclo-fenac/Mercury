# ==============================================================================
# Mercury AI Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the actual values.
# DO NOT commit the .env file to version control.

# ===== REQUIRED =====
SECRET_KEY="your-super-secret-key-here"

# ===== OPTIONAL (Required for full features) =====
# Used for chat AI features (Gemini)
GOOGLE_API_KEY="your-google-api-key"
GOOGLE_CLOUD_PROJECT="your-project-id"

# Modes: lite, standard, full
MERCURY_MODE="standard"

# ===== OPTIONAL (Defaults work out of the box with docker compose) =====
APP_NAME="Mercury AI Assistant"
VERSION="4.0.0"
DEBUG=false
PORT=8000

# --- Typesense Search ---
TYPESENSE_HOST="typesense"
TYPESENSE_PORT=8108
TYPESENSE_API_KEY="xyz"

# --- Redis Configuration ---
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""

# --- Database URLs ---
DATABASE_URL="postgresql+asyncpg://mercury:mercury_dev_password@postgres:5432/mercury"

# --- MinIO Storage (S3-compatible) ---
MINIO_ENDPOINT="minio:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET_NAME="mercury-uploads"
MINIO_SECURE=false

# --- Cache TTL Settings (in seconds) ---
CONVERSATION_CACHE_TTL=3600
CONTEXT_CACHE_TTL=1800

# --- File Upload Settings ---
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webp"

# --- Logging ---
LOG_LEVEL="INFO"
