# ==============================================================================
# Mercury AI Assistant - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the actual values.
# DO NOT commit the .env file to version control.

# --- App Settings ---
APP_NAME="Mercury AI Assistant"
VERSION="4.0.0"
DEBUG=false
PORT=8000

# --- Security ---
# Generate a strong secret key for production
SECRET_KEY="your-super-secret-key-here"

# --- Google Cloud & AI ---
GOOGLE_API_KEY="your-google-api-key"
GOOGLE_CLOUD_PROJECT="your-project-id"
# Path to Google Application Credentials JSON file
GOOGLE_APPLICATION_CREDENTIALS="path/to/credentials.json"

# --- Firestore ---
FIRESTORE_COLLECTION="products"
# Path to Firebase Credentials JSON file (if different from GOOGLE_APPLICATION_CREDENTIALS)
FIREBASE_CREDENTIALS_PATH="path/to/firebase-credentials.json"

# --- Google Cloud Storage ---
GCS_BUCKET_NAME="mercury-images"

# --- Qdrant Vector Database ---
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME="products"
QDRANT_API_KEY=""

# --- Typesense Search ---
TYPESENSE_HOST="localhost"
TYPESENSE_PORT=8108
TYPESENSE_API_KEY="xyz"

# --- Redis Configuration ---
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=""
# Optional: Full Redis URL (overrides individual settings if provided)
# REDIS_URL="redis://:password@localhost:6379/0"

# --- Cache TTL Settings (in seconds) ---
CONVERSATION_CACHE_TTL=3600
CONTEXT_CACHE_TTL=1800

# --- Third-Party APIs ---
WEATHER_API_KEY="your-weather-api-key"

# --- CORS Settings ---
# Comma-separated list of allowed origins
ALLOWED_ORIGINS="*"

# --- Database URLs ---
# Optional: For future SQL database support
# DATABASE_URL="postgresql://user:password@localhost:5432/dbname"

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL="INFO"

# --- File Upload Settings ---
# Max file size in bytes (default 10MB)
MAX_FILE_SIZE=10485760
# Comma-separated list of allowed MIME types
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,image/webp"

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Background Task Settings ---
ENABLE_BACKGROUND_TASKS=true
CONVERSATION_CLEANUP_INTERVAL=300
