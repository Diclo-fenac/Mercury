{
  "name": "mercury-widget",
  "version": "2.0.0",
  "description": "Zero-dependency Mercury Search Widget – Shadow DOM, WCAG AA, <30KB gzip",
  "scripts": {
    "build": "node build.mjs",
    "build:analyze": "node build.mjs --analyze",
    "test:unit": "node --test tests/unit/api.test.mjs",
    "test:e2e": "playwright test tests/e2e/widget.spec.ts --project=chromium",
    "test": "node --test tests/unit/api.test.mjs",
    "size": "gzip -c mercury-widget.min.js | wc -c && echo 'bytes gzip'",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "esbuild": "^0.24.0"
  }
}
